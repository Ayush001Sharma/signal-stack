# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signalstack

# --- Security ---
# Optional. When set, every /api request must include header X-API-Key: <value>.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Crawler politeness ---
CRAWLER_USER_AGENT=SignalStackBot/1.0 (+https://github.com/ayush001sharma/signal-stack; business-intelligence research bot)
REQUEST_TIMEOUT_SECONDS=20
PER_HOST_DELAY_SECONDS=1.5
MAX_RETRIES=2

# --- Optional local LLM (free, via Ollama). Set LLM_PROVIDER=none to disable. ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Embeddings: auto | sentence-transformers | tfidf ---
EMBEDDINGS_BACKEND=auto

# --- Optional: Reddit official API (free OAuth "script" app). Anonymous crawling is disallowed by reddit.com/robots.txt ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Uploads & scheduler ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
SCHEDULER_ENABLED=true
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
